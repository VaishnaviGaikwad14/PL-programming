#include <stdio.h> 
int main() { 
int intArr[5];
float floatArr[5];
char charArr[5]; 
int i; 
printf("Enter 5 integer elements: ");
for (i = 0; i < 5; i++) { 
scanf("%d", &intArr[i]);
} 
printf("Enter 5 float elements: "); 
for (i = 0; i < 5; i++) {
scanf("%f", &floatArr[i]);
} 
printf("Enter 5 characters: "); 
for (i = 0; i < 5; i++) { 
scanf(" %c", &charArr[i];
} 
printf("\nInteger Array:\n");
for (i = 0; i < 5; i++) { 
printf("Value = %d\tAddress = %p\n", intArr[i], (void*)&intArr[i]);
} 
printf("\nFloat Array:\n"); 
for (i = 0; i < 5; i++) { 
printf("Value = %.2f\tAddress = %p\n", floatArr[i], (void*)&floatArr[i]); 
} 
return 0;
}
printf("\nCharacter Array:\n"); 
for (i = 0; i < 5; i++) { printf("Value = %c\tAddress = %p\n", charArr[i], (void*)&charArr[i]); } return 0; } Sample Output 
